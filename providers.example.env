# multi — keys only. Real file: ~/.claude/multi/providers.env, mode 600.
# Never edit this by hand for a key: `scripts/setup.sh set <NAME>` prompts for
# it without echoing and writes the line. One variable per backend that needs
# one; the name is the backend's api_key_env in config.toml, or
# <NAME>_API_KEY by default. Models, endpoints and timeouts do NOT go here.
export OPENROUTER_API_KEY='sk-or-v1-...'
export ZAI_API_KEY='...'
export LOCAL_ROUTER_KEY='...'
export GEMINI_API_KEY='AIza...'
